<mxfile host="app.diagrams.net" modified="2026-11-15T19:24:00.000Z" agent="5.0" version="21.0.0" type="device">
  <diagram id="weekly-pay-flow-v2" name="Paycheck Calculator">
    <mxGraphModel dx="1000" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Terminator: Start -->
        <mxCell id="node_start" value="START" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="30" width="120" height="50" as="geometry" />
        </mxCell>
        <!-- Process: Set Constants -->
        <mxCell id="node_rates" value="SET BASE_RATE = 20&#xa;SET OT_RATE = 30&#xa;SET FULL_TIME = 40" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="190" y="115" width="180" height="65" as="geometry" />
        </mxCell>
        <!-- Input: Weekly Hours -->
        <mxCell id="node_input" value="READ weekly_hours" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="190" y="215" width="180" height="55" as="geometry" />
        </mxCell>
        <!-- Decision: Check Overtime -->
        <mxCell id="node_check" value="weekly_hours &gt; FULL_TIME?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="185" y="305" width="190" height="95" as="geometry" />
        </mxCell>
        <!-- Process: Standard Pay (No Branch) -->
        <mxCell id="node_no_ot" value="gross_pay = weekly_hours * BASE_RATE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="165" y="450" width="230" height="60" as="geometry" />
        </mxCell>
        <!-- Process: Overtime Pay (Yes Branch) -->
        <mxCell id="node_yes_ot" value="extra_hours = weekly_hours - FULL_TIME&#xa;gross_pay = (FULL_TIME * BASE_RATE) + (extra_hours * OT_RATE)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="450" y="320" width="320" height="65" as="geometry" />
        </mxCell>
        <!-- Output: Display Gross Pay -->
        <mxCell id="node_output" value="DISPLAY gross_pay" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="190" y="555" width="180" height="55" as="geometry" />
        </mxCell>
        <!-- Terminator: End -->
        <mxCell id="node_end" value="END" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="645" width="120" height="50" as="geometry" />
        </mxCell>
        <!-- Connectors -->
        <mxCell id="link1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node_start" target="node_rates">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="link2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node_rates" target="node_input">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="link3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node_input" target="node_check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="link4" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node_check" target="node_no_ot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="link5" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="node_check" target="node_yes_ot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="link6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node_no_ot" target="node_output">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="link7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="node_yes_ot" target="node_output">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="610" y="583" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="link8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node_output" target="node_end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
