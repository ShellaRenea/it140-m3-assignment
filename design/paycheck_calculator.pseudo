# IT 140 Module Three Assignment
START

SET BASE_RATE = 20
SET OT_RATE = 30
SET FULL_TIME = 40

INPUT weekly_hours

IF weekly_hours > FULL_TIME THEN
    LET extra_hours = weekly_hours - FULL_TIME
    LET gross_pay = (FULL_TIME * BASE_RATE) + (extra_hours * OT_RATE)
ELSE
    LET gross_pay = weekly_hours * BASE_RATE
END IF

OUTPUT gross_pay

END

